+    "VisionOverrideUnlocked": "月之轮",
+    "ConstellationBefore": "启喻鸟座",
+    "CvChinese": "周侗",
+    "CvJapanese": "白石晴香",
+    "CvEnglish": "萨凡娜·门泽尔",
+    "CvKorean": "朱艺瑨",
+    "CookBonus": {
+      "OriginItemId": 108910,
