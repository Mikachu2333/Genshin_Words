+  "FetterInfo": {
+    "Title": "系风攘影",
+    "Detail": "十分可靠，无所不能（自称）的「秘闻馆」员工。",
+    "Association": 12,
+    "Native": "秘闻馆",
+    "BirthMonth": 1,
+    "BirthDay": 5,
+    "VisionBefore": "风",
+    "VisionOverrideUnlocked": "神之眼",
+    "ConstellationBefore": "莓果座",
+    "CvChinese": "韩娇娇",
+    "CvJapanese": "稻垣好",
+    "CvEnglish": "桑妮雅·克鲁格",
+    "CvKorean": "吴捞妸",
+    "CookBonus": {
+      "OriginItemId": 108871,
+      "ItemId": 108921,
+      "InputList": [
+        110001,
+        101265,
+        101264,
+        110006
+      ]
+    },
+    "Fetters": [
+      {
+        "Title": "初次见面…",
+        "Context": "哟，初次见面，有什么要委托的事尽管说吧。无论是什么事，只要钱付够，我都能帮你…呃，大部分的事…肯定能帮你搞定。"
+      },
+      {
+        "Title": "闲聊·奈芙尔",
+        "Context": "唔…老板什么时候给我涨点工资呢，还有好多想买的东西…"
+      },
+      {
+        "Title": "闲聊·逛街",
+        "Context": "走，逛街去啊，带你见识点好玩的东西…别声张啊，我们悄悄去。"
+      },
+      {
+        "Title": "闲聊·阿舍鲁",
+        "Context": "上次我摸阿舍鲁的时候，它居然哧溜一下跑掉了，哼，今天不给它买鱼干吃了。"
+      },
+      {
+        "Title": "下雨的时候…",
+        "Context": "下雨了？走走走，躲躲雨去，别被淋湿了。"
+      },
+      {
+        "Title": "下雪的时候…",
+        "Context": "呜哇！雪飞进脖子了，冷死了冷死了——"
+      },
+      {
+        "Title": "在沙漠的时候…",
+        "Context": "呸呸呸，沙子飞嘴里了！"
+      },
+      {
+        "Title": "早上好…",
+        "Context": "早啊，吃早饭了没，我带你去吃点好吃的？"
+      },
+      {
+        "Title": "中午好…",
+        "Context": "唔，不然还是回店里睡个午觉吧，总觉得好困…"
+      },
+      {
+        "Title": "晚上好…",
+        "Context": "都这个时间了，收工收工，回去摸阿舍鲁去喽~"
+      },
+      {
+        "Title": "晚安…",
+        "Context": "呼啊——该睡觉了…喂，你还在忙啊？差不多也该休息去啦。"
+      },
+      {
+        "Title": "关于雅珂达自己·经历",
+        "Context": "来「秘闻馆」之前，我的「工作经历」可杂了，摸爬滚打了那么长时间，才遇见了奈姐这么一个好老板，也算是我苦尽甘来吧。"
+      },
+      {
+        "Title": "关于雅珂达自己·秘闻馆",
+        "Context": "老板对我挺好的，阿舍鲁对我也还算不错。嗯…但我有时候会不由自主地把老板叫做奈姐，怎么也改不过来…"
+      },
+      {
+        "Title": "关于我们·故乡",
+        "Context": "我的故乡？我都不记得了…我也不在意这种东西，只要能吃饱饭，能安稳睡觉的地方，就算是我的「故乡」喽。"
+      },
+      {
+        "Title": "关于我们·朋友",
+        "Context": "我们都一起出生入死过了，当然已经是朋友了。下次遇见麻烦的时候，我的背后就交给你喽，尽量别出卖我，好么？就算要卖，也请卖一个好价钱，不然我的身价可要跌了…哎呀，开玩笑的，我知道你不会出卖我，你是一个好人，不会做这种自私的事。"
+      },
+      {
+        "Title": "关于「神之眼」…",
+        "Context": "嘿嘿，它可是我的宝贝，有了它之后，干活都轻松不少。没想到啊没想到，我雅珂达也有运气这么好的时候…"
+      },
+      {
+        "Title": "有什么想要分享·宝藏猎人",
+        "Context": "你在街上是不是遇见过自称「宝藏猎人」的家伙？别被这个名号唬住了，你就把他们理解成挪德卡莱的「雇佣兵」就好了，只要给够钱，他们就会愿意给你办事。如果你真想找这群人帮忙的话，我认识几个好手，到时候介绍给你啊。"
+      },
+      {
+        "Title": "有什么想要分享·大炮",
+        "Context": "「轰隆隆月矩力能量炮」开炮的时候，真的很帅气啊。唔…要是能买一台那门大炮的等比例缩小机械模型就好了，爱诺能不能帮我做一台呢，反正这门大炮也是她造的…"
+      },
+      {
+        "Title": "感兴趣的见闻…",
+        "Context": "我昨天突然胡思乱想，你说…到底多少粒沙子聚在一起，才能被称为「一堆沙」呢？一百粒？一千粒？好像都不太对喔，过几天我去找爱诺问问好了，她肯定知道。"
+      },
+      {
+        "Title": "关于菈乌玛…",
+        "Context": "菈乌玛小姐？嗯…虽然我不怎么了解她，但我也知道她的身份可高了，实力也很强，而且她还能和动物说话呢，这么一来，希汐岛上的那些动物，不都等于是菈乌玛小姐的耳目了？怪不得没有宝藏猎人敢去希汐岛「寻宝」呢，这一上岛不就等于自投罗网吗…"
+      },
+      {
+        "Title": "关于伊涅芙…",
+        "Context": "啊，那个笨蛋机器人啊，做蛋卷挺好吃的啊，就是总记不住人说话，而且也没什么幽默感，随便说个玩笑都要认真地问我哪里好笑，但她的蛋卷真的很好吃喔，有机会你一定要尝尝。"
+      },
+      {
+        "Title": "关于奈芙尔…",
+        "Context": "奈姐当然是我最最亲爱的老板啦！嘿嘿嘿，她不仅给我开工资，还管吃管住。不过，她手底下好像也就只有我一个正式员工…啊，还有阿舍鲁，差点忘了。不过，阿舍鲁说是员工，却一次委托都没出过…哼，居然吃闲饭，下次我就抱着它出外勤去！"
+      },
+      {
+        "Title": "关于爱诺…",
+        "Context": "爱诺的手艺可好了，无论我把胳膊折腾成什么样，她都能修好。但是每次修理手臂的时候，爱诺都会在上面画画，说什么这样比较可爱，虽然确实挺可爱的，但她怎么不在伊涅芙身上画呢？"
+      },
