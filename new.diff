+  ],
+  "NameCard": {
+    "Name": "桑多涅·茶歇",
+    "Description": "名片纹饰。\n桑多涅喜欢茶会这一点，或许是从阿兰那里学来的。只有两个人的茶歇在当时还不觉得无聊。可是自从人多到能开茶会，随后又一个个离开之后，她似乎追上了一点当年阿兰的孤独。",
+    "Icon": "UI_NameCardIcon_MarionetteNew",
+    "PicturePrefix": "UI_NameCardPic_MarionetteNew"
